# Public site URL (used for canonical URLs, sitemap, structured data and as the "source" of
# appointment requests)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Review mode marks unapproved content and stops search engines indexing the site.
# Set to "false" ONLY after docs/LAUNCH-CHECKLIST.md has been signed off by the clinic.
# Demo mode is separate: while `demo` is true in src/lib/site.ts, the site says it is a demo with
# placeholder details and is also kept out of search engines. Turn it off once the clinic's own
# details are in place.
NEXT_PUBLIC_REVIEW_MODE=true

# --- Appointment requests: configure ONE of the two options below ---------------------------
# With neither configured, nothing is sent: the form asks visitors to call or WhatsApp instead.
# Option A: POST each request as JSON to a webhook (e.g. a CRM, Google Apps Script, Zapier).
APPOINTMENT_WEBHOOK_URL=
# Optional: if set, requests carry an "x-appointment-signature" header (HMAC-SHA256 of the body).
APPOINTMENT_WEBHOOK_SECRET=

# Option B: send each request by email through Resend (https://resend.com).
RESEND_API_KEY=
# One address, or several separated by commas.
APPOINTMENT_EMAIL_TO=appointments@example.com
APPOINTMENT_EMAIL_FROM="Clinic website <appointments@your-verified-domain>"
