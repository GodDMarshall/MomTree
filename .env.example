# Public site URL (used for canonical URLs, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=https://momtreeivf.com

# Review mode marks unapproved content and stops search engines indexing the site.
# Set to "false" ONLY after docs/APPROVAL-CHECKLIST.md has been signed off by the clinic.
NEXT_PUBLIC_REVIEW_MODE=true

# --- Appointment requests: configure ONE of the two options below ---------------------------
# Option A: POST each request as JSON to a webhook (e.g. a CRM, Google Apps Script, Zapier).
APPOINTMENT_WEBHOOK_URL=
# Optional: if set, requests carry an "x-momtree-signature" header (HMAC-SHA256 of the body).
APPOINTMENT_WEBHOOK_SECRET=

# Option B: send each request by email through Resend (https://resend.com).
RESEND_API_KEY=
APPOINTMENT_EMAIL_TO=momtreeivf@gmail.com
APPOINTMENT_EMAIL_FROM=Momtree Website <appointments@your-verified-domain>
